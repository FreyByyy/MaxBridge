# Токен бота от @BotFather
BOT_TOKEN=

# Ваш числовой Telegram ID (узнать: @userinfobot). Только этот человек управляет ботом.
OWNER_ID=

# Телефон аккаунта MAX (можно не указывать — бот спросит при /login)
MAX_PHONE=

# Часовой пояс для времени в сообщениях
TZ=Europe/Moscow

# Показывать ли аккаунт MAX «в сети», пока работает бот (по умолчанию — нет)
MAX_SHOW_ONLINE=false

# ИИ для спорных сообщений (необязательно; можно подключить позже командой /ai).
# Любой OpenAI-совместимый API: OpenAI, Anthropic, DeepSeek, OpenRouter, Ollama…
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

LOG_LEVEL=INFO
